{
  "compilerOptions": {
    "strict": true, "erasableSyntaxOnly": true, "module": "nodenext", "moduleResolution": "nodenext",
    "target": "es2024", "lib": ["es2024"], "types": ["node"],
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tools/**/*.ts", "scripts/**/*.ts", "self-checks.ts", "bench/**/*.ts"]
}
